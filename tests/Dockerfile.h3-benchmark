# syntax=docker/dockerfile:1.7
# V9 HTTP/3 正式横评镜像：Naway、固定 H1 backend 与 H3 client 来自同一源码/工具链，
# 运行时再与固定 Envoy 镜像放入同一 Docker network，排除 host NAT 路径不对称。
ARG NAWAY_SOURCE_FINGERPRINT=unknown
FROM rust:1-bookworm AS builder

WORKDIR /work
COPY naway ./naway
COPY nasa-runtime-rust ./nasa-runtime-rust

WORKDIR /work/naway
RUN --mount=type=cache,id=naway-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=naway-cargo-git,target=/usr/local/cargo/git/db,sharing=locked \
    --mount=type=cache,id=naway-h3-target,target=/work/naway/target,sharing=locked \
    cargo build --release --locked --features http3 --bin naway --bin local_h3_benchmark \
    && install -m 0755 target/release/naway /work/naway-bin \
    && install -m 0755 target/release/local_h3_benchmark /work/local-h3-benchmark

FROM debian:bookworm-slim
ARG NAWAY_SOURCE_FINGERPRINT
LABEL org.opencontainers.image.naway-source-fingerprint=$NAWAY_SOURCE_FINGERPRINT
COPY --from=builder /work/naway-bin /usr/local/bin/naway
COPY --from=builder /work/local-h3-benchmark /usr/local/bin/local_h3_benchmark

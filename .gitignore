!/tests/http3_acceptance.rs
!/tests/http3_live.rs
!/tests/scripts/
/tests/scripts/*
!/tests/scripts/http3_compare.sh
!/tests/support/
/tests/support/*
!/tests/support/local_h3_benchmark.rs
